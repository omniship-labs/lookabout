[Unit]
Description=Lookabout camera
After=network-online.target
Wants=network-online.target

[Service]
# install.sh fills in the user and install path.
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 -m lookabout_rpi --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
